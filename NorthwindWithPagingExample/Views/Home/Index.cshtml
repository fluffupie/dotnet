@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div>
    <h1 class="display-4">Customers with orders</h1>
    <table class="table">
        <tr>
            <th>@Html.DisplayNameFor(x => x.CustomerId)</th>
            <th>@Html.DisplayNameFor(x => x.CompanyName)</th>
            <th>@Html.DisplayNameFor(x => x.Country)</th>
            <th>@Html.DisplayNameFor(x => x.City)</th>
            <th>@Html.DisplayNameFor(x => x.Address)</th>
            <th>@Html.DisplayNameFor(x => x.PostalCode)</th>
            <th></th>
        </tr>
        @foreach(var customer in Model) {
            <tr>
                <td>@Html.DisplayFor(x => customer.CustomerId)</td>
                <td>@Html.DisplayFor(x => customer.CompanyName)</td>
                <td>@Html.DisplayFor(x => customer.Country)</td>
                <td>@Html.DisplayFor(x => customer.City)</td>
                <td>@Html.DisplayFor(x => customer.Address)</td>
                <td>@Html.DisplayFor(x => customer.PostalCode)</td>
                <td>
                    <form asp-action="IndexToViewOrders">
                        <input type="hidden" name="customerID" value="@customer.CustomerId" />
                        <input type="submit" class="btn btn-primary" value="View Orders" />
                    </form>
                </td>
            </tr>
        }
    </table>
</div>
