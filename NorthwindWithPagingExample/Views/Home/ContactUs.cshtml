@model bool
@{
    ViewData["Title"] = "Contact Us";

    WebsiteContext webContext = new WebsiteContext {
        Version = new Version(1, 3),
        CopyrightYear = 1638,
        Approved = true,
        TagsToShow = 131
    };
}

<h1>@ViewData["Title"]</h1>

<address>
    One Microsoft Way<br />
    Redmond, WA 98052<br />
    <abbr title="Phone">P:</abbr>
    425.555.0100
</address>

<address>
    @* Version #1. *@
    <strong>Support:</strong> <email>Support</email>
    <br />
    <strong>Marketing:</strong> <email>Marketing</email>
    
    @* Version #2. *@
    @*<strong>Support:</strong> <email mail-to="Support"></email>
    <br />
    <strong>Marketing:</strong> <email mail-to="Marketing"></email>*@
    
    @* Version #3. *@
    @*<strong>Support:</strong> <email>Support</email>
    <br />
    <strong>Marketing:</strong> <email>Marketing</email>*@
</address>

@* Version #1. *@
<p bold>Use this area to provide additional information.</p>

@* Version #2. *@
<bold>Is this bold?</bold>

<h3>Web site info</h3>
<website-information info="webContext" />

@* Set Model to true by appending ?approved=true to the URL. *@
<div condition="Model">
    <fieldset class="border p-2">
        <legend class="w-auto">This content is conditional!</legend>
        <img src="/img/dog-with-glasses.jpg" alt="Dog with glasses" style="width: 300px;" />
    </fieldset>
</div>
